# ==============================================================================
# IP Reputation Score API - Complete Production Environment Configuration
# ==============================================================================
# Copy this file to '.env' and update the secrets before running in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER ENVIRONMENT & ROUTING
# ------------------------------------------------------------------------------
# ENVIRONMENT: Mode of deployment. Options: 'development', 'staging', 'production'.
ENVIRONMENT=production

# DEBUG: Enable detailed stack traces and dev logging. MUST be 'false' in production.
DEBUG=false

# API_PREFIX: Base routing prefix for all v1 API endpoints.
API_PREFIX=/api/v1


# ------------------------------------------------------------------------------
# 2. SECURITY, CRYPTOGRAPHY & PII-ZERO COMPLIANCE
# ------------------------------------------------------------------------------
# SALT_SECRET: Secret key used to compute daily UTC HMAC/SHA-256 hashes for Redis keys.
# CRITICAL: Change to a random 32+ character string in production!
SALT_SECRET=change-me-in-production-super-secret-salt-key-32-chars!

# JWT_SECRET: Secret key or RSA/Ed25519 public key for verifying Bearer JWT tokens.
# CRITICAL: Must be at least 32 bytes minimum for HMAC SHA-256 security.
JWT_SECRET=change-me-in-production-jwt-secret-key-32-bytes-minimum!

# JWT_ALGORITHM: Signing algorithm for Bearer JWT token verification (e.g. HS256, RS256, EdDSA).
JWT_ALGORITHM=HS256

# ALLOW_PRIVATE_IPS_FOR_TESTING: Set to 'true' ONLY for local dev/testing with RFC1918 IPs (10.x, 192.168.x).
ALLOW_PRIVATE_IPS_FOR_TESTING=false


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION KEYS & SCOPE MAPPING
# ------------------------------------------------------------------------------
# API_KEYS: JSON string mapping API Keys (or their SHA-256 hashes) to granted scopes.
# Scopes available: 'score:read', 'metrics:read', 'admin:feeds', '*' (all).
API_KEYS='{"sk_test_1234567890abcdef": ["score:read", "metrics:read"], "sk_admin_9876543210fedcba": ["score:read", "metrics:read", "admin:feeds"], "sk_live_prod_key_12345": ["score:read", "metrics:read"]}'


# ------------------------------------------------------------------------------
# 4. HIGH-PERFORMANCE CACHING (L1 RAM + L2 REDIS)
# ------------------------------------------------------------------------------
# CACHE_ENABLED: Master switch to enable/disable L1 and L2 caching layer.
CACHE_ENABLED=true

# REDIS_URL: Connection URL for Redis L2 cache service.
REDIS_URL=redis://redis:6379/0

# REDIS_PASSWORD: Password for Redis server authentication (leave blank if unauthenticated).
REDIS_PASSWORD=

# CACHE_TTL_SECONDS: Default time-to-live for evaluated IP scores in Redis L2 cache (default: 300s = 5 mins).
CACHE_TTL_SECONDS=300

# L1_CACHE_MAX_SIZE: Maximum number of entries stored in ultra-fast L1 RAM LRU cache (< 0.3 ms hit).
L1_CACHE_MAX_SIZE=10000

# L1_CACHE_TTL_SECONDS: Expiration window for L1 RAM LRU cache entries in seconds.
L1_CACHE_TTL_SECONDS=300

# FCRDNS_TIMEOUT_SECONDS: Strict socket timeout for Forward-Confirmed Reverse DNS (FCrDNS) lookups.
FCRDNS_TIMEOUT_SECONDS=1.0

# MATCHING_STRATEGY: Algorithmic strategy for IP set matching.
# Options: 'v5_hybrid' (default, 2,115 IPs/sec & sub-10ms), 'v5_pure' (6.75 ms min p50), 'v4_bytecode' (2,235 IPs/sec), 'v3_standard'.
MATCHING_STRATEGY=v5_hybrid


# ------------------------------------------------------------------------------
# 5. RATE LIMITING & BATCH SAFETY CONTROLS
# ------------------------------------------------------------------------------
# RATE_LIMIT_PER_MINUTE: Maximum requests per minute allowed per client API key/token.
RATE_LIMIT_PER_MINUTE=100

# BATCH_MAX_SIZE: Maximum allowed number of IP addresses in a single 'POST /api/v1/score/batch' request.
BATCH_MAX_SIZE=50

# MAX_REQUEST_BODY_SIZE: Maximum allowed request payload size in bytes (default: 1048576 = 1 MB).
MAX_REQUEST_BODY_SIZE=1048576


# ------------------------------------------------------------------------------
# 6. DATA DIRECTORIES & MAXMIND ASN DATABASE
# ------------------------------------------------------------------------------
# DATA_DIR: Base directory path for operational state and persistent storage.
DATA_DIR=./data

# FEEDS_DIR: Directory path where threat feed disk caches and SHA-256 integrity sidecars are saved.
FEEDS_DIR=./data/feeds

# MAXMIND_ASN_DB_PATH: Path to GeoLite2-ASN.mmdb database file for ASN organization resolution.
MAXMIND_ASN_DB_PATH=./data/mmdb/GeoLite2-ASN.mmdb

# FEED_UPDATE_INTERVAL_HOURS: Frequency in hours for background threat feeds refresh worker.
FEED_UPDATE_INTERVAL_HOURS=12


# ------------------------------------------------------------------------------
# 7. THREAT INTELLIGENCE FEEDS URLs (10 FEEDS INTEGRATED)
# ------------------------------------------------------------------------------
# Tor Exit Nodes Official List (The Tor Project)
TOR_EXIT_NODES_URL=https://check.torproject.org/torbulkexitlist

# Spamhaus DROP List (Spamhaus Project)
SPAMHAUS_DROP_URL=https://www.spamhaus.org/drop/drop.txt

# FireHOL Level 1 Blocklist (FireHOL Project)
FIREHOL_L1_URL=https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset

# AWS Official IP Ranges (Amazon Web Services)
AWS_IP_RANGES_URL=https://ip-ranges.amazonaws.com/ip-ranges.json

# GCP Official IP Ranges (Google Cloud Platform)
GCP_IP_RANGES_URL=https://www.gstatic.com/ipranges/cloud.json

# Apple Private Relay Official Egress Ranges (Apple Inc.)
APPLE_PRIVATE_RELAY_URL=https://mask-api.icloud.com/egress-ip-ranges.csv

# Team Cymru Fullbogons IPv4 List (Team Cymru)
TEAM_CYMRU_BOGONS_URL=https://www.team-cymru.org/Services/Bogons/fullbogons-ipv4.txt

# Cloudflare Egress IPv4 & IPv6 Ranges (Cloudflare Inc.)
CLOUDFLARE_IPS_V4_URL=https://www.cloudflare.com/ips-v4
CLOUDFLARE_IPS_V6_URL=https://www.cloudflare.com/ips-v6

# Fastly Egress Ranges (Fastly Inc.)
FASTLY_IPS_URL=https://api.fastly.com/public-ip-list

# Abuse.ch Feodo Tracker C2 Blocklist (Abuse.ch)
ABUSE_CH_C2_URL=https://feodotracker.abuse.ch/downloads/ipblocklist.txt

# ThreatFox Threat Intelligence List (Abuse.ch)
THREATFOX_C2_URL=https://urlhaus.abuse.ch/downloads/hostfile/

# OpenPhish Active Phishing Feed (OpenPhish)
OPENPHISH_URL=https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt

# IPsum Aggregated Threat Feed (IPsum / Stamparm)
PHISHING_IPSUM_URL=https://raw.githubusercontent.com/stamparm/ipsum/master/ipsum.txt

# Oracle Cloud Infrastructure (OCI) IP Ranges
OCI_IP_RANGES_URL=https://docs.oracle.com/en-us/iaas/tools/public_ip_ranges.json

# DigitalOcean Official IP Ranges
DIGITALOCEAN_IP_RANGES_URL=https://www.digitalocean.com/geo/google.csv

# FireHOL Datacenter Blocklist (FireHOL Project)
FIREHOL_DATACENTER_URL=https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/datacenter.netset

# Alibaba Cloud Aliyun Official IP Ranges (Alibaba Group)
ALIBABA_IP_RANGES_URL=https://raw.githubusercontent.com/ipverse/iptoasn-webservice/master/alibaba.netset

# Tencent Cloud Official IP Ranges (Tencent Holdings)
TENCENT_IP_RANGES_URL=https://raw.githubusercontent.com/ipverse/iptoasn-webservice/master/tencent.netset

# Vultr Official IP Ranges (Vultr / Constant Co)
VULTR_IP_RANGES_URL=https://raw.githubusercontent.com/ipverse/iptoasn-webservice/master/vultr.netset

# Tor Relay Nodes Consensus List (The Tor Project)
TOR_RELAYS_URL=https://check.torproject.org/exit-addresses

# GreenSnow Dynamic Proxies & Threat Feed (GreenSnow Project)
GREENSNOW_URL=https://blocklist.greensnow.co/greensnow.txt
